{
  "name": "warm-up-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold a language-organized warm-up coding workspace.",
  "type": "module",
  "bin": {
    "warm-up": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/src/cli.js",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/sql-sqlite-node": "^4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.4",
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
